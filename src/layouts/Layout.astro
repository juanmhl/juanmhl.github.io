---
const { title } = Astro.props;
const pageTitle = title ? `${title} // Juan María Herrera-López` : 'Juan María Herrera-López';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --bg: #080808;
      --text: #f2f2f2;
      --accent: #ffffff;
      --muted: rgba(242, 242, 242, 0.4);
      --separator: rgba(255, 255, 255, 0.1);
      --nav-border: rgba(255, 255, 255, 0.08);
      --font-heading: 'Space Mono', monospace;
      --font-body: 'Inter', sans-serif;
      --content-max: 830px;
      --content-pad: 24px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      background-color: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-y: scroll;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      animation: fadeIn 300ms ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-heading);
      font-weight: 400;
      color: var(--accent);
      line-height: 1.3;
      text-align: left;
    }

    h1 { font-size: 28px; margin-bottom: 32px; }
    h2 { font-size: 20px; margin-top: 40px; margin-bottom: 16px; }
    h3 { font-size: 16px; margin-top: 24px; margin-bottom: 12px; }

    p {
      margin-bottom: 16px;
      color: var(--text);
    }

    a {
      color: var(--accent);
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    hr {
      border: none;
      border-top: 1px solid var(--separator);
      margin: 40px 0;
    }

    ul, ol {
      margin-bottom: 16px;
      padding-left: 24px;
    }

    li {
      margin-bottom: 8px;
    }

    main {
      display: block;
      width: 100%;
      max-width: var(--content-max);
      margin: 0 auto;
      padding: 120px var(--content-pad) 80px;
      text-align: justify;
    }

    ::selection {
      background-color: var(--accent);
      color: var(--bg);
    }

    footer {
      max-width: var(--content-max);
      margin: 0 auto;
      padding: 0 var(--content-pad) 40px;
      font-family: var(--font-heading);
      font-size: 11px;
      color: rgba(242, 242, 242, 0.25);
      text-align: left;
    }

    footer a {
      color: rgba(242, 242, 242, 0.35);
    }

    footer a:hover {
      color: rgba(242, 242, 242, 0.6);
    }
  </style>
</head>
<body>
  <slot />
  <footer>
    <a href="https://github.com/juanmhl/juanmhl.github.io" target="_blank" rel="noopener">source</a>
    {' // '}
    <a href="https://github.com/juanmhl/juanmhl.github.io/blob/main/LICENSE" target="_blank" rel="noopener">MIT license</a>
  </footer>
</body>
</html>